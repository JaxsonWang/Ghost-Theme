{{!< default}}

{{#post}}
<article class="links-page {{post_class}}">
    <header class="links-page-head wrap">
        <div class="links-page-heading">
            <p class="listing-kicker">朋友们</p>
            <h1>{{title}}</h1>
        </div>
        <p class="links-page-count" data-links-count-wrap hidden><strong data-links-count></strong><span>位朋友</span></p>
    </header>

    <section class="links-wall wrap" aria-label="友链列表">
        <div class="links-source gh-content" data-links-source>{{content}}</div>
    </section>
</article>
{{/post}}
