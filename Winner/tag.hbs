{{!< default}}

{{#tag}}
<section class="cover-head{{#if feature_image}} cover-head--with-image{{/if}}" aria-labelledby="tag-title">
    {{#if feature_image}}
        <img class="cover-head-image" src="{{img_url feature_image size="l"}}" alt="">
    {{/if}}
    <div class="wrap">
        <div class="cover-head-copy">
            <h1 id="tag-title">{{name}}</h1>
            <p>{{#if description}}{{description}}{{else}}{{plural ../pagination.total empty="暂无文章" singular="1 篇文章" plural="% 篇文章"}}{{/if}}</p>
        </div>
    </div>
</section>
{{/tag}}
<section class="sec wrap">
    <div class="post-grid">
        {{#foreach posts}}{{> "card"}}{{else}}<p class="empty-state">这个标签下还没有文章。</p>{{/foreach}}
    </div>
    <div class="pagination-wrap">{{pagination}}</div>
</section>
