{{!< default}}

{{^is "paged"}}
<section class="hero" aria-labelledby="hero-title" data-theme-content="hero" data-content-config="{{@custom.hero}}" hidden>
    <div class="hero-grid wrap">
        <div class="hero-main">
            <h1 class="hero-title" id="hero-title"><span data-setting-text="titleLineOne"></span><span data-setting-visible="titleLineTwo"><br><span data-setting-text="titleLineTwo"></span></span><em data-setting-text="titleAccent" data-setting-visible="titleAccent"></em></h1>
            <div class="hero-cta">
                {{#foreach posts limit="1"}}
                    <a class="btn" href="{{url}}" data-setting-visible="ctaText"><span data-setting-text="ctaText"></span><i>→</i></a>
                {{/foreach}}
            </div>
        </div>
        <p class="hero-lede" data-setting-text="sideText" data-setting-visible="sideText"></p>
        <figure class="hero-figure">
            {{#if @site.cover_image}}
                <img src="{{img_url @site.cover_image size="xl"}}" alt="{{@site.title}}" fetchpriority="high">
            {{else}}
                <img src="{{asset "images/night-transit.jpg"}}" width="1800" height="1200" alt="{{@site.title}}" fetchpriority="high">
            {{/if}}
        </figure>
    </div>
</section>
{{/is}}

<section class="sec wrap" id="posts" aria-label="文章">
    <div class="sec-head reveal">
        <h1>最近写的</h1>
        <p class="sec-count">{{plural pagination.total empty="暂无文章" singular="1 篇" plural="% 篇"}}</p>
    </div>
    <div class="post-grid">
        {{#foreach posts}}
            {{> "card"}}
        {{else}}
            <p class="empty-state">还没有发布文章。</p>
        {{/foreach}}
    </div>
    <div class="pagination-wrap">{{pagination}}</div>
</section>

<section class="sec about" id="about" aria-labelledby="about-title" data-theme-content="homepage_about" data-content-config="{{@custom.homepage_about}}" hidden>
    <div class="about-grid wrap reveal">
        <p class="about-vert" data-setting-text="sideText" data-setting-visible="sideText"></p>
        <div class="about-copy">
            <h2 id="about-title"><span data-setting-text="titleLineOne"></span><span data-setting-visible="titleLineTwo"><br><span data-setting-text="titleLineTwo"></span></span></h2>
            <div class="about-detail">
                <p class="about-body" data-setting-text="bodyText" data-setting-visible="bodyText"></p>
                <div class="about-actions">
                    <p class="about-cta" data-setting-visible="ctaText ctaUrl"><a class="btn btn--ghost" data-setting-href="ctaUrl"><span data-setting-text="ctaText"></span><i>→</i></a></p>
                    {{> "social-links"}}
                </div>
            </div>
        </div>
    </div>
</section>
